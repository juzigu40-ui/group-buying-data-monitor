# Runtime environment
GBM_TIMEZONE=Asia/Shanghai
GBM_DB_PATH=data/monitor.db
GBM_LOG_LEVEL=INFO

# Customer-editable schedule overrides. If omitted, the built-in defaults are used.
GBM_REVIEW_WINDOW_START=10:00
GBM_REVIEW_WINDOW_END=20:00
GBM_REVIEW_INTERVAL_MINUTES=120
GBM_DELIVERY_LUNCH_START=10:30
GBM_DELIVERY_LUNCH_END=12:30
GBM_DELIVERY_DINNER_START=17:00
GBM_DELIVERY_DINNER_END=19:00
GBM_DELIVERY_INTERVAL_MINUTES=30
GBM_SIGNAL_WINDOW_START=10:00
GBM_SIGNAL_WINDOW_END=21:00
GBM_SIGNAL_INTERVAL_MINUTES=60

# Customer-editable Feishu push webhook. If configured, scripts/run_profile.sh will auto-push
# the run summary and real-time signal report to Feishu.
# If you want to do a full delivery acceptance in Feishu, this should be filled.
GBM_FEISHU_WEBHOOK=
# Comma separated mobiles, for example: 13800138000,13900139000
GBM_FEISHU_AT_MOBILES=

# Demo input files (replace with real adapters in production)
GBM_DIANGPING_FILE=examples/review_dianping.json
GBM_DOUYIN_FILE=examples/review_douyin.json
GBM_AMAP_FILE=examples/review_amap.json
GBM_MEITUAN_FILE=examples/delivery_meituan.json
GBM_ELEME_FILE=examples/delivery_eleme.json
GBM_JDWM_FILE=examples/delivery_jdwm.json
GBM_STORE_REGISTRY=examples/stores_registry.json
GBM_SIGNAL_RULES=examples/store_signal_rules.template.json
