# Runtime environment
GBM_TIMEZONE=Asia/Shanghai
GBM_DB_PATH=data/monitor.db
GBM_LOG_LEVEL=INFO

# Optional Feishu push webhook
GBM_FEISHU_WEBHOOK=
# Comma separated mobiles, for example: 13800138000,13900139000
GBM_FEISHU_AT_MOBILES=

# Demo input files (replace with real adapters in production)
GBM_DIANGPING_FILE=examples/review_dianping.json
GBM_DOUYIN_FILE=examples/review_douyin.json
GBM_AMAP_FILE=examples/review_amap.json
GBM_MEITUAN_FILE=examples/delivery_meituan.json
GBM_ELEME_FILE=examples/delivery_eleme.json
GBM_JDWM_FILE=examples/delivery_jdwm.json
GBM_STORE_REGISTRY=examples/stores_registry.json
